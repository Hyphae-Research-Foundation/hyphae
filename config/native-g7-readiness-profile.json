    "local-prepared-sql-primary-key": {"p50": 35000, "p99": 150000},
    "indexed-sql-bounded-read": {"p50": 50000, "p99": 250000},
    "two-index-join-bounded-read": {"p50": 75000, "p99": 400000},
    "bm25-top10": {"p50": 100000, "p99": 500000},
    "filtered-bm25-top10": {"p50": 200000, "p99": 750000},
