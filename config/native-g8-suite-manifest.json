    },
    {
      "id": "format2-to-native-migration",
      "status": "implemented-unhosted",
      "platforms": ["linux", "macos", "windows"],
      "runner": "cargo test -p hyphae-cli migration_",
      "acceptance": ["read-only-source", "identity-mapping", "semantic-equivalence", "promotion", "rollback"]
    },
    {
      "id": "multiplatform-packaging",
      "status": "implemented-unhosted",
      "platforms": ["x86_64-unknown-linux-gnu", "x86_64-apple-darwin", "aarch64-apple-darwin", "x86_64-pc-windows-msvc"],
      "runner": "python packaging/package.py && python packaging/verify_install.py",
      "acceptance": ["archive-layout", "installed-native-smoke"]
    },
    {
      "id": "sbom-signatures-provenance",
      "status": "implemented-unhosted",
      "platforms": ["release"],
      "runner": "python packaging/release_evidence.py verify",
      "acceptance": ["spdx", "cyclonedx", "checksums", "cosign", "provenance"]
