      "id": "native-soak",
      "status": "implemented-unhosted",
      "platforms": ["linux"],
      "runner": "python tools/run_native_g8_soak.py",
      "acceptance": ["kill-restart", "backup-restore", "doctor-after-restore"]
    },
    {
      "id": "process-crash-recovery",
      "status": "implemented-unhosted",
      "platforms": ["linux"],
      "runner": "cargo run -p hyphae-native-runtime --example process_crash_matrix",
      "acceptance": ["commit-boundaries", "checkpoint-boundaries", "snapshot-pins", "migration-promotion-boundaries"]
    },
    {
      "id": "power-loss-replay",
      "status": "implemented-unhosted",
      "platforms": ["linux"],
      "runner": "python tools/run_native_power_loss_gate.py",
      "acceptance": ["bounded-replay", "recovery-equivalence", "safety-checks"]
    },
    {
      "id": "corruption-matrix",
      "status": "implemented-unhosted",
      "platforms": ["linux"],
      "runner": "cargo test --workspace --all-features corruption",
      "acceptance": ["pages", "wal", "manifest", "blobs", "indexes", "proofs"]
    },
    {
      "id": "resource-exhaustion",
      "status": "implemented-unhosted",
      "platforms": ["linux"],
      "runner": "python tools/run_native_resource_exhaustion_gate.py",
