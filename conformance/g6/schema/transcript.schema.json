{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "$id": "https://hyphae.dev/schema/native-g6-transcript-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lane", "adapter", "transport", "start", "cases", "coverage", "status"],
  "properties": {
    "schema": {"const": "hyphae-native-g6-transcript-v1"},
    "lane": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["rust", "cli", "http", "python", "typescript"]},
    "transport": {"enum": ["embedded", "cli", "native-local", "http-v2"]},
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory_lineage", "catalog_version", "visible_csn", "root_digest"],
      "properties": {
        "directory_lineage": {"type": "string", "pattern": "^[0-9a-f]{48}$"},
        "catalog_version": {"type": "integer", "minimum": 1},
        "visible_csn": {"type": ["integer", "null"], "minimum": 1},
        "root_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "outcome"], "properties": {"id": {"type": "string", "minLength": 1}, "outcome": {"type": "object", "minProperties": 1}}}},
    "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"const": "passed"}
  }
}
