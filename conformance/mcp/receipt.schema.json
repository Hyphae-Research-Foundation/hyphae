{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://hyphae.dev/schema/mcp-host-conformance-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "host",
    "host_version",
    "host_platform",
    "source_commit",
    "source_tree",
    "source_mode",
    "adapter_sha256",
    "host_executable_sha256",
    "host_package_name",
    "host_package_version",
    "host_package_integrity",
    "host_lock_sha256",
    "host_package_lock_sha256",
    "mcp_config_sha256",
    "installed_mcp_config_sha256",
    "corpus_sha256",
    "tool_schema_version",
    "tools",
    "cases",
    "transcript_sha256"
  ],
  "properties": {
    "schema": {"const": "hyphae-mcp-host-conformance-receipt-v1"},
    "status": {"const": "passed"},
    "host": {"enum": ["claude-code", "codex"]},
    "host_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "host_platform": {"enum": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_mode": {"enum": ["clean", "integration"]},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "host_executable_sha256": {"$ref": "#/$defs/sha256"},
    "host_package_name": {"enum": ["@anthropic-ai/claude-code", "@openai/codex"]},
    "host_package_version": {"enum": ["2.1.233", "0.147.0"]},
    "host_package_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
    "host_lock_sha256": {"$ref": "#/$defs/sha256"},
    "host_package_lock_sha256": {"$ref": "#/$defs/sha256"},
    "mcp_config_sha256": {"$ref": "#/$defs/sha256"},
    "installed_mcp_config_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "tool_schema_version": {"const": "hyphae-native-mcp-tools-v2"},
    "tools": {"const": ["hyphae_native_capabilities", "hyphae_native_security_status", "hyphae_native_security_principals"]},
    "cases": {"const": ["capabilities-read", "security-status-read", "principal-page-read", "prompt-authority-rejected"]},
    "transcript_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
