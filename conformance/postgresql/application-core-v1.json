          "docs/roadmaps/universal-engine-program.md"
        ],
        "executable_authority": null,
        "note": "ON CONFLICT is a planned application-profile gap, not current behavior."
      }
    },
    {
      "id": "explicit-transaction-savepoint",
      "priority": "P0",
      "mandatory": true,
      "requirement": "Explicit begin, commit, rollback, savepoint, and rollback-to-savepoint preserve the expected write set.",
      "oracle": "conformance/postgresql/cases/explicit-transaction-savepoint.sql",
      "oracle_sha256": "8f5a49499b3009960f630222c983f1623b76324af9ba121c53ab7092bede1192",
      "hyphae": {
        "classification": "partial",
        "evidence": [
          "docs/native/sql-semantics-v1.md",
          "crates/hyphae-native-runtime/tests/local_all_engine_transaction.rs"
        ],
        "executable_authority": null,
        "note": "Explicit begin, commit, and rollback exist; SQL savepoint execution is not implemented."
      }
    },
    {
      "id": "basic-joins",
      "priority": "P0",
      "mandatory": true,
      "requirement": "A parameterized indexed inner equijoin returns the matching application row.",
      "oracle": "conformance/postgresql/cases/basic-joins.sql",
      "oracle_sha256": "52a69cadf89f1a784395301dc5ed3ed51ce1e91158fbd5be4ba50544f0fa2544",
      "hyphae": {
        "classification": "conformant",
        "evidence": [
          "docs/native/sql-semantics-v1.md",
          "crates/hyphae-native-runtime/tests/local_sql_select.rs"
        ],
        "executable_authority": {
          "kind": "cargo-test",
          "path": "crates/hyphae-native-runtime/tests/local_sql_select.rs",
          "package": "hyphae-native-runtime",
          "test_target": "local_sql_select",
          "test_name": "unix::uds_sql_matches_physical_plans_recovers_failures_and_reopens",
          "command": [
            "cargo",
            "test",
            "--locked",
            "-p",
            "hyphae-native-runtime",
            "--test",
            "local_sql_select",
            "unix::uds_sql_matches_physical_plans_recovers_failures_and_reopens",
            "--",
            "--exact"
          ]
        },
        "note": "The authority requires indexed nested-loop paths for distinct true/false parameter results across two groups, with literal ordered rows and exact right-probe counts; wrong, cross-product, ignored-ON, and ignored-WHERE outcomes are negative controls. Outer and general joins are not implied."
      }
    },
    {
      "id": "group-by",
      "priority": "P0",
      "mandatory": true,
      "requirement": "A bounded GROUP BY with COUNT produces deterministic ordered groups.",
      "oracle": "conformance/postgresql/cases/group-by.sql",
      "oracle_sha256": "43ede570d8ebceee1fbbe68c7f2228057069cbf71c6daff809bb23a27029356b",
      "hyphae": {
        "classification": "conformant",
        "evidence": [
          "docs/native/sql-semantics-v1.md",
          "crates/hyphae-native-runtime/tests/sql_group_by_g2.rs"
        ],
        "executable_authority": {
          "kind": "cargo-test",
          "path": "crates/hyphae-native-runtime/tests/sql_group_by_g2.rs",
          "package": "hyphae-native-runtime",
          "test_target": "sql_group_by_g2",
          "test_name": "projected_group_key_and_count_are_explicitly_ordered",
          "command": [
            "cargo",
            "test",
            "--locked",
            "-p",
            "hyphae-native-runtime",
            "--test",
            "sql_group_by_g2",
            "projected_group_key_and_count_are_explicitly_ordered",
            "--",
            "--exact"
          ]
        },
        "note": "The authority projects the group key and COUNT(*), orders by that key, and includes the positive LIMIT required by Hyphae's bounded grouped profile."
      }
    },
    {
      "id": "catalog-columns",
