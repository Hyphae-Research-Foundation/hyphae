  "cases": [
    {
      "id": "identifiers",
      "priority": "P0",
      "mandatory": true,
      "requirement": "Unquoted identifiers fold to lowercase and quoted identifiers preserve exact case.",
      "oracle": "conformance/postgresql/cases/identifiers.sql",
      "oracle_sha256": "5b67c852ea2d60ba17bfb817118315f1e37109d6c483158638b5f27259790500",
      "hyphae": {
        "classification": "partial",
        "evidence": [
          "docs/native/catalog-v1.md",
          "crates/hyphae-native-runtime/src/sql.rs"
        ],
        "executable_authority": null,
        "note": "Catalog names model quoted preservation, but the SQL lexer erases quotedness before identifier normalization."
      }
    },
    {
      "id": "typed-parameters",
      "priority": "P0",
      "mandatory": true,
      "requirement": "Application-supplied integer, text, and boolean parameters retain declared types.",
      "oracle": "conformance/postgresql/cases/typed-parameters.sql",
      "oracle_sha256": "52e9ea8db94960e82735a93f256eab5d8f75330a31382051cb853ac18bb3a11b",
      "hyphae": {
        "classification": "conformant",
        "evidence": [
          "docs/native/sql-semantics-v1.md",
          "crates/hyphae-native-runtime/tests/sql_typed_parameters.rs"
        ],
        "executable_authority": {
          "kind": "cargo-test",
          "path": "crates/hyphae-native-runtime/tests/sql_typed_parameters.rs",
          "package": "hyphae-native-runtime",
          "test_target": "sql_typed_parameters",
          "test_name": "parameterized_insert_persists_declared_integer_text_and_boolean_types",
          "command": [
            "cargo",
            "test",
            "--locked",
            "-p",
            "hyphae-native-runtime",
            "--test",
            "sql_typed_parameters",
            "parameterized_insert_persists_declared_integer_text_and_boolean_types",
            "--",
            "--exact"
          ]
        },
        "note": "The native API parameterizes INSERT with typed values, commits and reopens persisted BIGINT/TEXT/BOOLEAN data, and uses question-mark placeholders rather than PostgreSQL wire placeholders."
      }
    },
    {
      "id": "constraint-sqlstate",
      "priority": "P0",
      "mandatory": true,
      "requirement": "Unique, not-null, check, and foreign-key failures expose the PostgreSQL SQLSTATE classes used by applications.",
      "oracle": "conformance/postgresql/cases/constraint-sqlstate.sql",
      "oracle_sha256": "9a87d98a43e17aa28b7928c053ffe5b69c0ad13e0f7c650173405355ff32ef9b",
      "hyphae": {
        "classification": "unsupported",
        "evidence": [
          "docs/native/sql-semantics-v1.md",
          "docs/native/product-error-v1.md"
        ],
        "executable_authority": null,
        "note": "Hyphae has stable native constraint errors; compatibility SQLSTATE mapping remains a target requirement."
      }
    },
    {
      "id": "redundant-limit-point-lookup",
      "priority": "P0",
      "mandatory": true,
      "requirement": "A primary-key point lookup accepts a redundant positive LIMIT without changing its result.",
      "oracle": "conformance/postgresql/cases/redundant-limit-point-lookup.sql",
      "oracle_sha256": "a36546365d5113d2d9fcd7d280823462850bbdde4cc3fe63adee995be719735d",
      "hyphae": {
        "classification": "unverified",
        "evidence": [
          "crates/hyphae-native-runtime/src/sql.rs",
          "crates/hyphae-native-runtime/src/lib.rs"
        ],
        "executable_authority": null,
        "note": "The rebased implementation and unit coverage admit redundant positive LIMIT on a full primary-key lookup, but this profile cell remains open until it has a dedicated case-specific executable authority."
      }
    },
    {
      "id": "like-bind",
      "priority": "P0",
      "mandatory": true,
      "requirement": "A text LIKE pattern can be supplied as a typed application parameter.",
      "oracle": "conformance/postgresql/cases/like-bind.sql",
      "oracle_sha256": "39ad3618f8f28a4f0626e617048de92ac1662173d07e88102a04dfbaf858d995",
      "hyphae": {
        "classification": "unsupported",
        "evidence": [
          "crates/hyphae-native-runtime/tests/sql_like_in_g2.rs"
        ],
        "executable_authority": null,
        "note": "The bounded residual LIKE slice currently requires a text literal and rejects a pattern parameter."
      }
    },
    {
      "id": "returning",
      "priority": "P0",
      "mandatory": true,
      "requirement": "INSERT, UPDATE, and DELETE can return affected application columns in the same statement.",
      "oracle": "conformance/postgresql/cases/returning.sql",
      "oracle_sha256": "2c96e4453ebfc42d480eca8ca42a7898c8dcdfdcf91643b4b20d2500056f32c5",
      "hyphae": {
        "classification": "unsupported",
        "evidence": [
          "docs/native/sql-semantics-v1.md"
        ],
        "executable_authority": null,
        "note": "RETURNING is outside the current bounded mutation grammar."
      }
    },
    {
      "id": "on-conflict",
      "priority": "P0",
      "mandatory": true,
      "requirement": "A primary-key conflict supports deterministic DO UPDATE and DO NOTHING outcomes.",
      "oracle": "conformance/postgresql/cases/on-conflict.sql",
      "oracle_sha256": "29634c77dc5a337200587972c24c0e2fc9fdc61098da67432bec0fa224be3959",
      "hyphae": {
