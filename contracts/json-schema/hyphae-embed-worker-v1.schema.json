{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://hyphae.dev/contracts/json-schema/hyphae-embed-worker-v1.schema.json",
  "title": "Hyphae local embedding worker request and response v1",
  "description": "One bounded NDJSON exchange per private Linux Unix connection. Relational vector dimensions, text counts, model identity, UTF-8 byte bounds and attestation verification also apply.",
  "oneOf": [
    {
      "$ref": "#/$defs/HyphaeEmbedWorkerRequest"
    },
    {
      "$ref": "#/$defs/HyphaeEmbedWorkerResponse"
    }
  ],
  "$defs": {
    "HyphaeEmbedWorkerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "operation"
      ],
      "properties": {
        "schema": {
          "const": "hyphae-embed-request-v1"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "operation": {
          "enum": [
            "status",
            "embed",
            "rerank"
          ]
        },
        "texts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 65536,
            "x-hyphae-maxUtf8Bytes": 65536
          },
          "default": []
        },
        "query": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 65536,
              "x-hyphae-maxUtf8Bytes": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_model": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "operation": {
              "const": "status"
            },
            "texts": {
              "maxItems": 0
            },
            "query": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "texts"
          ],
          "properties": {
            "operation": {
              "const": "embed"
            },
            "texts": {
              "minItems": 1
            },
            "query": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "texts",
            "query"
          ],
          "properties": {
            "operation": {
              "const": "rerank"
            },
            "texts": {
              "minItems": 1
            },
            "query": {
              "type": "string"
            }
          }
        }
      ]
    },
    "HyphaeEmbedWorkerResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "id",
            "ok",
            "result"
          ],
          "properties": {
            "schema": {
              "const": "hyphae-embed-response-v1"
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "ok": {
              "const": true
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "https://hyphae.dev/contracts/json-schema/hyphae-attested-model-v1.schema.json"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "target",
                    "model",
                    "attestation_hex",
                    "dimensions",
                    "vectors"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "x-hyphae-maxUtf8Bytes": 256
                    },
                    "model": {
                      "$ref": "https://hyphae.dev/contracts/json-schema/hyphae-attested-model-v1.schema.json"
                    },
                    "attestation_hex": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})+$"
                    },
                    "schema": {
                      "const": "hyphae-embed-output-v1"
                    },
                    "dimensions": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "vectors": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4096,
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "target",
                    "model",
                    "attestation_hex",
                    "scores"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "x-hyphae-maxUtf8Bytes": 256
                    },
                    "model": {
                      "$ref": "https://hyphae.dev/contracts/json-schema/hyphae-attested-model-v1.schema.json"
                    },
                    "attestation_hex": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})+$"
                    },
                    "schema": {
                      "const": "hyphae-rerank-output-v1"
                    },
                    "scores": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "id",
            "ok",
            "error"
          ],
          "properties": {
            "schema": {
              "const": "hyphae-embed-response-v1"
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "invalid_request",
                    "response_too_large"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
