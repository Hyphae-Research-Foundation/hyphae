{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://hyphae.dev/contracts/json-schema/native-performance-suite-v1.schema.json",
  "title": "Hyphae Native performance suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "suite_profile_sha256", "source_commit", "source_tree", "binary_sha256", "clean", "hardware_fingerprint", "receipts", "claims", "closure_declared"],
  "properties": {
    "schema": {"const": "hyphae-native-performance-suite-v1"},
    "status": {"const": "passed"},
    "suite_profile_sha256": {"$ref": "#/$defs/sha256"},
    "source_commit": {"$ref": "#/$defs/sha1"},
    "source_tree": {"$ref": "#/$defs/sha1"},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "clean": {"type": "boolean"},
    "hardware_fingerprint": {"$ref": "#/$defs/sha256"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "native-performance-receipt-v1.schema.json"}
    },
    "claims": {"const": []},
    "closure_declared": {"const": false}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
