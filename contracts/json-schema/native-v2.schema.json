{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://hyphae.dev/contracts/native-v2.schema.json",
  "title": "NativeRequestV2",
  "description": "One transport-independent Hyphae Native v2 operation and execution context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "logical_time_micros", "durability", "limits", "operation"],
  "properties": {
    "request_id": {
      "description": "Nonzero unsigned 128-bit request identity as canonical decimal text.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,38}$"
    },
    "logical_time_micros": {
      "description": "Logical time used by snapshots and TTL behavior.",
      "type": "integer"
    },
    "deadline_micros": {
      "description": "Optional positive absolute Unix-time deadline in microseconds.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "durability": { "$ref": "#/$defs/DurabilityV2" },
    "limits": { "$ref": "#/$defs/ProductLimitsV2" },
    "operation": { "$ref": "#/$defs/OperationV2" }
  },
  "$defs": {
    "DurabilityV2": {
      "description": "Mutation acknowledgement policy.",
      "enum": ["strict", "group", "memory"]
    },
    "ProductLimitsV2": {
      "description": "Central count, byte, work, and memory envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_count", "max_request_bytes", "max_response_bytes", "max_work_units", "max_memory_bytes"],
      "properties": {
        "max_count": { "type": "integer", "minimum": 1 },
        "max_request_bytes": { "type": "integer", "minimum": 1 },
        "max_response_bytes": { "type": "integer", "minimum": 1 },
        "max_work_units": { "type": "integer", "minimum": 1 },
        "max_memory_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "OperationV2": {
      "description": "Closed high-level operation family. Arguments are family-specific typed JSON models.",
      "oneOf": [
        { "$ref": "#/$defs/OperationV2Capabilities" },
        { "$ref": "#/$defs/OperationV2Catalog" },
        { "$ref": "#/$defs/OperationV2Sql" },
        { "$ref": "#/$defs/OperationV2Structure" },
        { "$ref": "#/$defs/OperationV2Search" },
        { "$ref": "#/$defs/OperationV2SearchCollection" },
        { "$ref": "#/$defs/OperationV2SearchIngest" },
        { "$ref": "#/$defs/OperationV2MemoryRecall" },
        { "$ref": "#/$defs/OperationV2MemoryEnrich" },
        { "$ref": "#/$defs/OperationV2Admin" },
        { "$ref": "#/$defs/OperationV2Telemetry" },
        { "$ref": "#/$defs/OperationV2Doctor" },
        { "$ref": "#/$defs/OperationV2Backup" },
        { "$ref": "#/$defs/OperationV2ProofVerify" },
        { "$ref": "#/$defs/OperationV2TransactionStatus" },
        { "$ref": "#/$defs/OperationV2SecurityApiKey" }
      ]
    },
    "OperationV2Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "capabilities" } }
    },
    "OperationV2Catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "catalog" },
        "action": { "enum": ["object", "object_named", "list", "visible_list", "dependencies", "describe", "resolve", "create"] },
        "arguments": {
          "description": "visible_list uses optional opaque binary cursor bytes, optional parent/kind filters, and positive item_limit/visit_limit/byte_limit. Cursor internals are never JSON fields.",
          "type": "object"
        }
      }
    },
    "OperationV2Sql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "sql" },
        "action": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2Structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "structure" },
        "action": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2Search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "search" },
        "action": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2SearchCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "search_collection" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2SearchIngest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "search_ingest" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2MemoryRecall": {
      "description": "Protocol minor 7. Search and lifecycle composition on one immutable snapshot; see docs/native/agent-memory-read-v1.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "memory_recall" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["collections", "search", "limit"],
          "properties": {
            "collections": {
              "description": "Distinct nonzero u128 IDs in ascending numeric order, encoded as decimal strings in JSON.",
              "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" }
            },
            "search": {
              "description": "ProductSearchRequest; candidate limit must be at least the final memory limit. Offset, explicit sorting, facets and aggregations are excluded.",
              "type": "object", "required": ["limit"],
              "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } }
            },
            "limit": { "type": "integer", "minimum": 1, "maximum": 64 },
            "provenance": { "description": "Opaque attested query metadata, at most 65536 decoded bytes. Sealed by memory proofs.", "type": "string", "contentEncoding": "base64", "maxLength": 87384 }
          }
        }
      }
    },
    "OperationV2MemoryEnrich": {
      "description": "Protocol minor 7. Strict conditional enrichment of an unchanged live memory; requires maintenance authority.",
      "type": "object", "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "memory_enrich" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["collection", "expected_envelope_digest", "idempotency_id", "document"],
          "properties": {
            "collection": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" },
            "expected_envelope_digest": { "description": "BLAKE3 of the exact live lifecycle envelope, 32 decoded bytes.", "type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44 },
            "idempotency_id": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" },
            "document": { "description": "ProductDocument retaining original text and base doc values; only the memory vector and embedding metadata may change.", "type": "object" }
          }
        }
      }
    },
    "OperationV2Admin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "admin" },
        "action": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2Telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "telemetry" } }
    },
    "OperationV2Doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "doctor" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2Backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "backup" },
        "action": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2ProofVerify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "proof_verify" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2TransactionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arguments"],
      "properties": {
        "kind": { "const": "transaction_status" },
        "arguments": { "type": "object" }
      }
    },
    "OperationV2SecurityApiKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "arguments"],
      "properties": {
        "kind": { "const": "security_api_key" },
        "action": {
          "enum": [
            "issue_self_start", "issue_start", "issue_self_activate", "issue_activate",
            "rotate_self_start", "rotate_start", "rotate_self_activate", "rotate_activate",
            "issue_self_abort", "issue_abort", "rotate_self_abort", "rotate_abort",
            "revoke_self", "revoke", "legacy_bearer_revoke"
          ]
        },
        "arguments": {
          "description": "No filesystem path is accepted. All writes require strict durability and nonzero idempotency; activation carries a 32-byte confirmation digest.",
          "type": "object",
          "not": {
            "anyOf": [
              { "required": ["path"] },
              { "required": ["key_out"] },
              { "required": ["output_path"] }
            ]
          }
        }
      }
    },
    "NativeResponseV2": {
      "description": "Definitive response after transport completion validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "kind", "value"],
      "properties": {
        "request_id": { "type": "string" },
        "kind": { "type": "string" },
        "value": {}
      }
    },
    "NativeOperationResultV2": {
      "description": "Transport-independent operation result represented by its stable response kind and family-specific value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string" },
        "value": {}
      }
    }
  }
}
