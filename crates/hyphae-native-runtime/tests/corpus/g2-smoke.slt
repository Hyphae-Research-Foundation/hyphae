CREATE TABLE audit (id BIGINT PRIMARY KEY, actor TEXT, note TEXT NOT NULL)

statement ok
INSERT INTO audit (id, actor, note) VALUES (1, 'alice', 'created'), (2, 'albert', 'updated'), (3, NULL, 'archived'), (4, 'bob', 'deleted')

query I
SELECT id FROM audit ORDER BY id DESC LIMIT 2
----
4
3

query I
SELECT id FROM audit WHERE id >= 1 AND id <= 4 AND actor LIKE 'al%' LIMIT 10
----
1
2

query I
SELECT id FROM audit WHERE id >= 1 AND id <= 4 AND actor IN ('bob', 'carol') LIMIT 10
----
4

query I
SELECT id FROM audit WHERE id >= 1 AND id <= 4 AND actor NOT IN ('alice', NULL) LIMIT 10
