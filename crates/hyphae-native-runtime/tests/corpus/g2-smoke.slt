CREATE TABLE metrics (id BIGINT PRIMARY KEY, class TEXT NOT NULL, score BIGINT)

statement ok
INSERT INTO metrics (id, class, score) VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', NULL), (4, 'b', 40)

query IIIII
SELECT COUNT(*), COUNT(score), SUM(score), MIN(score), MAX(score) FROM metrics WHERE id >= 1 AND id <= 4
----
4 3 70 10 40

query R
SELECT AVG(score) FROM metrics WHERE id >= 1 AND id <= 4
----
23.333

query I
SELECT COUNT(*) FROM metrics
----
4

query III
SELECT COUNT(*), SUM(score), MAX(score) FROM metrics WHERE id >= 100 AND id <= 200
----
0 NULL NULL

