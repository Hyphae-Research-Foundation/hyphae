{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://hyphae.dev/schemas/release-evidence-v1.json",
  "title": "HyphaeReleaseEvidenceV1",
  "description": "Post-commit evidence binding one Hyphae release run to its source tree and primary release artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "repository",
    "release",
    "source",
    "workflow",
    "artifacts"
  ],
  "allOf": [
    {
      "properties": {
        "artifacts": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "archive"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 4,
              "maxContains": 4
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "provenance"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 4,
              "maxContains": 4
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "sbom-spdx"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "sbom-cyclonedx"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "tag_object": {
                "type": "string"
              },
              "tag_target": {
                "type": "string"
              }
            },
            "required": [
              "tag_object",
              "tag_target"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 11,
            "maxItems": 11,
            "contains": {
              "properties": {
                "role": {
                  "const": "required-checks"
                }
              },
              "required": [
                "role"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "minItems": 10,
            "maxItems": 10,
            "not": {
              "contains": {
                "properties": {
                  "role": {
                    "const": "required-checks"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "tag_object": {
                "type": "string"
              }
            },
            "required": [
              "tag_object"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "tag_object": {
                "type": "string"
              },
              "tag_target": {
                "type": "string"
              }
            }
          },
          "workflow": {
            "oneOf": [
              {
                "properties": {
                  "ref": {
                    "pattern": "^refs/tags/"
                  },
                  "event": {
                    "enum": [
                      "push",
                      "workflow_dispatch"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "event"
                ]
              },
              {
                "properties": {
                  "ref": {
                    "const": "refs/heads/main"
                  },
                  "event": {
                    "const": "workflow_dispatch"
                  }
                },
                "required": [
                  "ref",
                  "event"
                ]
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "properties": {
              "tag_object": {
                "type": "null"
              },
              "tag_target": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "release-evidence-v1"
    },
    "schema_version": {
      "const": 1
    },
    "repository": {
      "const": "https://github.com/Hyphae-Research-Foundation/hyphae"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "version"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "tag_object",
        "tag_target"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag_object": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag_target": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "ref",
        "event",
        "run_id",
        "run_attempt",
        "url"
      ],
      "properties": {
        "path": {
          "const": ".github/workflows/release.yml"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/"
        },
        "event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/Hyphae-Research-Foundation/hyphae/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "role": {
            "enum": [
              "archive",
              "provenance",
              "required-checks",
              "sbom-cyclonedx",
              "sbom-spdx"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "archive"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "oneOf": [
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-aarch64-apple-darwin\\.tar\\.gz$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-apple-darwin\\.tar\\.gz$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-pc-windows-msvc\\.zip$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-unknown-linux-gnu\\.tar\\.gz$"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "provenance"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "oneOf": [
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-aarch64-apple-darwin\\.tar\\.gz\\.provenance\\.json$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-apple-darwin\\.tar\\.gz\\.provenance\\.json$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-pc-windows-msvc\\.zip\\.provenance\\.json$"
                    },
                    {
                      "pattern": "^hyphae-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-x86_64-unknown-linux-gnu\\.tar\\.gz\\.provenance\\.json$"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "required-checks"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "pattern": "^hyphae-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.required-checks\\.json$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "sbom-cyclonedx"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "pattern": "^hyphae-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.cdx\\.json$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "sbom-spdx"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "pattern": "^hyphae-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.spdx\\.json$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
