{
  "name": "@hyphae_/hyphae",
  "version": "2.0.0",
  "description": "Bounded TypeScript client for Hyphae v1 and Native v2 APIs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-DOCUMENTATION",
    "LICENSE-POLICY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "rm -rf dist && npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "conformance": "npm run build && node conformance/run.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1",
    "@types/node": "^24.10.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@noble/hashes": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@noble/hashes": {
      "optional": true
    }
  }
}
